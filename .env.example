# Configurações do Servidor Node.js / Express
PORT=3000
NODE_ENV=development

# Credenciais Públicas do Firebase Client (Vite)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=applet-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=applet-id
VITE_FIREBASE_STORAGE_BUCKET=applet-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Chave de API Server-Side do Gemini (Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Credenciais Admin do Firebase (Server-Side verification)
FIREBASE_SERVICE_ACCOUNT_KEY=

# GL PRO FIT - Variáveis de Ambiente

# Feature Flag de Banco de Dados Real (true = Nuvem, false = LocalStorage / Mocks)
VITE_USE_REAL_DATABASE=false
VITE_DATABASE_PROVIDER=firebase

# Firebase Firestore (Recomendado para ecossistema web Vite + listeners em tempo real)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (Alternativa PostgreSQL Relacional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

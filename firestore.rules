rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return isSignedIn() && 'role' in request.auth.token ? request.auth.token.role : 'aluno';
    }

    function isSystemAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'marinho.gianluca@gmail.com' ||
        userRole() == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function hasRole(allowedRoles) {
      return isSignedIn() && (isSystemAdmin() || userRole() in allowedRoles);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connectivity verification probe
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // 1. System Users (Desativado campo 'password' em qualquer gravação)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasRole(['admin', 'gerente']));
      allow create, update: if isSystemAdmin() && isValidId(userId) && !('password' in incoming());
      allow delete: if isSystemAdmin() && isValidId(userId);
    }
    match /system_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasRole(['admin', 'gerente']));
      allow create, update: if isSystemAdmin() && isValidId(userId) && !('password' in incoming());
      allow delete: if isSystemAdmin() && isValidId(userId);
    }

    // 2. Empresas Clientes (B2B SaaS - Acesso Restrito a Administradores)
    match /empresas_clientes/{empresaId} {
      allow read, write: if isSystemAdmin() && isValidId(empresaId);
    }

    // 3. Students (Exige consentLgpd == true na criação)
    match /students/{studentId} {
      allow read: if hasRole(['admin', 'gerente', 'recepcao', 'treinador', 'financeiro']);
      allow create: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(studentId) &&
        incoming().consentLgpd == true;
      allow update: if hasRole(['admin', 'gerente', 'recepcao', 'treinador']) && isValidId(studentId);
      allow delete: if isSystemAdmin() && isValidId(studentId);
    }

    // 4. Health & Medical Data (Apenas Admin, Gerente e Treinador)
    match /workouts/{workoutId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(workoutId);
    }
    match /physical_assessments/{assessmentId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(assessmentId);
    }
    match /wellness_checkins/{checkinId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(checkinId);
    }
    match /nutrition_plans/{planId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(planId);
    }
    match /exercise_load_logs/{logId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(logId);
    }
    match /exercise_load_history/{logId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(logId);
    }

    // 5. Financial Data (Admin, Gerente e Financeiro; Recepção cria vendas/comandas sem alterar histórico)
    match /financial_transactions/{txId} {
      allow read: if hasRole(['admin', 'gerente', 'financeiro']);
      allow create: if hasRole(['admin', 'gerente', 'financeiro', 'recepcao']) && isValidId(txId);
      allow update, delete: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(txId);
    }
    match /pay_recurring/{chargeId} {
      allow read, write: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(chargeId);
    }
    match /recurring_charges/{chargeId} {
      allow read, write: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(chargeId);
    }
    match /payment_links/{linkId} {
      allow read, write: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(linkId);
    }
    match /comandas/{comandaId} {
      allow read: if hasRole(['admin', 'gerente', 'financeiro', 'recepcao']);
      allow create, update: if hasRole(['admin', 'gerente', 'financeiro', 'recepcao']) && isValidId(comandaId);
      allow delete: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(comandaId);
    }
    match /products/{productId} {
      allow read: if hasRole(['admin', 'gerente', 'financeiro', 'recepcao']);
      allow create, update, delete: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(productId);
    }
    match /stock_movements/{movementId} {
      allow read, write: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(movementId);
    }
    match /suppliers/{supplierId} {
      allow read, write: if hasRole(['admin', 'gerente', 'financeiro']) && isValidId(supplierId);
    }

    // 6. Operational & Operational Management
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if hasRole(['admin', 'gerente']) && isValidId(planId);
    }
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if hasRole(['admin', 'gerente', 'treinador', 'recepcao']) && isValidId(classId);
    }
    match /crm_activities/{activityId} {
      allow read, write: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(activityId);
    }
    match /leads/{leadId} {
      allow read, write: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(leadId);
    }
    match /crm_automations/{automationId} {
      allow read, write: if hasRole(['admin', 'gerente']) && isValidId(automationId);
    }
    match /satisfaction_surveys/{surveyId} {
      allow read, write: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(surveyId);
    }
    match /calendar_events/{eventId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador', 'recepcao']) && isValidId(eventId);
    }
    match /team_tasks/{taskId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador', 'recepcao', 'financeiro']) && isValidId(taskId);
    }
    match /whatsapp_chats/{chatId} {
      allow read, write: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(chatId);
    }
    match /whatsapp_messages/{msgId} {
      allow read, write: if hasRole(['admin', 'gerente', 'recepcao']) && isValidId(msgId);
    }
    match /exercises_catalog/{exId} {
      allow read: if isSignedIn();
      allow write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(exId);
    }
    match /lesson_plans/{planId} {
      allow read, write: if hasRole(['admin', 'gerente', 'treinador']) && isValidId(planId);
    }
    match /tab_settings/{tabId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin() && isValidId(tabId);
    }
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin() && isValidId(settingId);
    }

    // 7. Security Audit Logs (Escrita via Admin SDK, Leitura Restrita a Admin)
    match /security_audit_logs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 8. Default-deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
